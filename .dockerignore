# Keep the build context -- and therefore the image -- small.

# Local models, checkpoints and results (several GB): the API downloads its model
# from the GitHub release while the image is built (see Dockerfile).
local_data/
dist/
PPO_SB3/
PPO_SB3_*/

# Caches and build artefacts
**/__pycache__/
**/*.py[cod]
*.egg-info/
build/
dist/

# Not needed to serve the API
.git/
.github/
getting_started/
logs/
model_logs/
**/*.log
**/*.ipynb
**/.ipynb_checkpoints/
**/*Zone.Identifier
